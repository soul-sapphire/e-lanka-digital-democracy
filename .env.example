# ==============================================================================
# E-Lanka Digital Democracy Platform - Environment Configuration (EL-SPEC-2026-V3)
# Compliance: Sri Lanka Personal Data Protection Act (PDPA), No. 9 of 2022
# ==============================================================================

# Server
PORT=4000
NODE_ENV=development

# 1. Field-Level Encryption (FLE) - AES-256-GCM
# Master key used to derive 256-bit symmetric key for encrypting PII & open text
FLE_MASTER_KEY=e-lanka-pdpa-2026-master-aes-key-change-in-prod-32b!
FLE_KEY_VERSION=v1

# 2. HMAC-SHA256 Blind Indexing Pepper
# Salted pepper for deterministic duplicate NIC / Email checks without decryption
BLIND_INDEX_PEPPER=e-lanka-pdpa-salt-pepper-2026-v1-secret
BLIND_INDEX_SALT_VERSION=v1

# 3. PDPA Statutory Audit Ledger (Section 23)
# HMAC secret used for cryptographically chaining immutable audit blocks
PDPA_AUDIT_SECRET=e-lanka-pdpa-audit-immutable-chain-2026-secret

# 4. Authentication & RBAC
JWT_SECRET=e-lanka-jwt-token-signature-key-2026

# 5. Multi-Channel Dispatcher (WhatsApp / Email)
INVITATION_SECRET=e-lanka-invite-dispatch-token-secret-2026

# 6. Database (Supabase PostgreSQL)
# Leave empty for local in-memory fallback store; provide for live cloud DB
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 7. AI Opinion Mapping & Scrubbing Worker (Workstream 4)
# Used for sentiment extraction and natural language clustering
GEMINI_API_KEY=
GROQ_API_KEY=

